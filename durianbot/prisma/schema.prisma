// Production schema for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanInterval {
  month
  year

  @@map("plan_interval")
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
  unpaid

  @@map("subscription_status")
}

enum MediaType {
  photo
  video

  @@map("media_type")
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  lastName   String?  @map("last_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  subscriptions Subscription[]
  inviteTokens  InviteToken[]
  mediaPosts    MediaPost[]
  postUnlocks   PostUnlock[]

  @@map("users")
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  stripePriceId String      @unique @map("stripe_price_id")
  priceCents   Int          @map("price_cents")
  interval     PlanInterval
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  // Relations
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  planId            String             @map("plan_id")
  stripeCustomerId  String             @map("stripe_customer_id")
  stripeSubId       String             @unique @map("stripe_subscription_id")
  status            SubscriptionStatus
  currentPeriodEnd  DateTime           @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model InviteToken {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  chatInviteLink  String   @map("chat_invite_link")
  expiresAt       DateTime @map("expires_at")
  redeemed        Boolean  @default(false)
  redeemedAt      DateTime? @map("redeemed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model MediaPost {
  id             String    @id @default(cuid())
  type           MediaType
  fileId         String    @map("file_id")
  caption        String?
  postedAt       DateTime  @default(now()) @map("posted_at")
  postedByUserId String?   @map("posted_by_user_id")

  // Relations
  postedBy User? @relation(fields: [postedByUserId], references: [id])

  @@index([postedAt])
  @@map("media_posts")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  stripeEventId String @unique @map("stripe_event_id")
  eventType   String   @map("event_type")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@map("webhook_events")
}

model UnlockablePost {
  id                String   @id @default(cuid())
  fileId            String   @map("file_id") // Original full quality file
  fileType          MediaType @map("file_type") // photo or video
  previewFileId     String   @map("preview_file_id") // Blurred preview file
  caption           String?
  priceUSD          Int      @map("price_usd") // Price in cents
  stripeProductId   String   @map("stripe_product_id")
  stripePriceId     String   @unique @map("stripe_price_id")
  messageId         Int?     @map("message_id") // Group message ID
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  unlocks           PostUnlock[]

  @@index([createdAt])
  @@map("unlockable_posts")
}

model PostUnlock {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  postId            String   @map("post_id")
  stripePaymentId   String   @unique @map("stripe_payment_id")
  amountPaid        Int      @map("amount_paid") // In cents
  downloaded        Boolean  @default(false) // Track if user downloaded (1-time limit)
  downloadedAt      DateTime? @map("downloaded_at")
  
  unlockedAt        DateTime @default(now()) @map("unlocked_at")
  
  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              UnlockablePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("post_unlocks")
}

